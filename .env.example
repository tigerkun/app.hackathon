# SafeSphere Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env before starting the backend service.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Runtime Environment (development | test | production)
NODE_ENV=development

# HTTP Service Port
PORT=3000

# Primary JWT Secret for User Access Tokens (Required in production: >= 32 chars)
JWT_SECRET=safesphere_dev_jwt_secret_key_2026_super_secure

# Refresh JWT Secret for Long-Lived Session Refresh (Required in production: >= 32 chars, distinct from JWT_SECRET)
JWT_REFRESH_SECRET=safesphere_dev_jwt_refresh_secret_key_2026_super_secure

# Bcrypt Salt Rounds for Password and PIN Hashing (10 recommended in production, 8 in test)
SALT_ROUNDS=10

# JWT Access Token Expiry in seconds (900s = 15 minutes)
JWT_EXPIRES_IN=900

# JWT Refresh Token Expiry in seconds (604800s = 7 days)
REFRESH_EXPIRES_IN=604800

# Comma-separated exact browser origins in production; * is dev-only and ignored in production.
CORS_ORIGIN=*

# SQLite Database Storage File Path (:memory: for ephemeral test runner, local path or /var/data/safesphere.db)
DB_PATH=./data/safesphere.db

# Demo Mode Flag (true enables demo user seed and mock endpoints; must be false in production)
DEMO_MODE=true
