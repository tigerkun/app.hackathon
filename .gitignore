# ==============================================================================
# SafeSphere Monorepo Unified .gitignore
# ==============================================================================

# Teamwork & Agent Metadata (must not be committed to user repos)
.agents/

# Node.js & Monorepo Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment & Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# Local Databases & Persistent SQLite
*.sqlite
*.sqlite3
*.db
backend/data/*.sqlite
backend/*.sqlite

# Flutter, Dart & Mobile Runner Caches
.dart_tool/
**/.dart_tool/
.pub-cache/
**/.pub-cache/
.pub/
**/.pub/
build/
**/build/
coverage/
**/coverage/
.flutter-plugins
.flutter-plugins-dependencies
.packages
frontend/.dart_tool/
frontend/build/
frontend/.pub-cache/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
**/ios/Flutter/.last_build_id
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
app.*.symbols
app.*.map.json

# Python Bytecode & Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# IDE & Editor Configurations
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store
*.swp
*.class
*.log
.history
.build/
.buildlog/
migrate_working_dir/
